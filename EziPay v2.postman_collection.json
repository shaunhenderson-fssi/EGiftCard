							"// Set your secret key\r",
							"const secretKey = pm.variables.get(\"Ezipay_password\");\r",
							"\r",
							"const crypt = require('crypto-js');\r",
							"\r",
							"var xmlRequest = pm.request.body.raw;\r",
							"console.log('xmlRequest:', xmlRequest);\r",
							"\r",
							"xmlRequest = xmlRequest.replace(/<USERNAME>(.*?)<\\/USERNAME>/g, '<USERNAME>' + pm.variables.get('Ezipay_username') + '</USERNAME>');\r",
							"xmlRequest = xmlRequest.replace(/<PASSWORD>(.*?)<\\/PASSWORD>/g, '<PASSWORD>' + pm.variables.get('Ezipay_password') + '</PASSWORD>');\r",
							"\r",
							"// Generate HMAC signature\r",
							"const signature = crypt.HmacSHA256(xmlRequest, secretKey).toString(crypt.enc.Hex);\r",
							"console.log('HMAC Signature:', signature);\r",
							"\r",
							"xmlRequest = xmlRequest.replace(/<PASSWORD>(.*?)<\\/PASSWORD>/g, '<SIGNATURE>' + signature + '</SIGNATURE>');\r",
							"\r",
							"console.log('xmlRequest:', xmlRequest);\r",
							"// Set the signature as an environment variable\r",
							"//pm.environment.set('hmacSignature', signature);\r",
